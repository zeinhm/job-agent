#!/usr/bin/env bash
# dispatch: runs the board. No AI in here, only bookkeeping. Keep the Hermes gateway OFF.
#   bin/dispatch            run continuously        bin/dispatch --once     one pass (and wait for jobs)
#
# Where work runs:  dev -> Claude Code cloud session (cloud credit); after the credit: local Pro
#                   qa / auditor / researcher / pm -> local Claude Code on Pro (bin/agent-step)
# Cards are only BLOCKED for a question ("HELD #n [DOCTOR|OWNER]: ..."), always with a unique reason, so
# Hermes never moves them to triage. Waiting is tracked here:
#   cloud work in progress  -> card stays Running, state in data/dispatch/cloud/<id>
#   Pro limit reached       -> card back to Ready, all Pro roles pause until the reset
#   waiting for a rework    -> card back to Todo, linked to the rework card
set -uo pipefail
. "$(dirname "$0")/lib.sh"
cd "$REPO"
ONCE=0; [ "${1:-}" = "--once" ] && ONCE=1
ROLES=" dev qa auditor researcher pm "

hold() { # $1 id, $2 DOCTOR|OWNER, $3 text  (unique reason -> never triage)
  local k; k="$(counter notes "$1.hold")"
  hk block "$1" "HELD #$k [$2]: $3" >/dev/null; log "hold $1 [$2]: $3"; }
wait_on() { # $1 id, $2 new parent id, $3 why -> card back to todo, waiting for the parent
  local k; k="$(counter notes "$1.wait")"
  hk link "$2" "$1" >/dev/null
  hk block "$1" "WAIT #$k: $3 ($2)" >/dev/null; hk unblock "$1" >/dev/null; log "wait $1 on $2: $3"; }
parents_done() { local p s; for p in $(field "$(card "$1")" parents | tr ',' ' '); do
    s="$(status_of "$p")"; case "$s" in done|archived) ;; *) return 1 ;; esac; done; return 0; }
busy_role()  { ls "$STATE/running" 2>/dev/null | grep -q "\.$1\$"; }
local_count(){ ls "$STATE/running" 2>/dev/null | wc -l | tr -d ' '; }

# ------------------------------------------------------------------ batch audits (counted, created in code)
maybe_batch_audit() {
  local cut total med low n f="$STATE/merged.log"
  [ -f "$f" ] || return 0
  cut="$(cat "$STATE/audit-cutoff" 2>/dev/null || echo 0)"; total="$(wc -l < "$f" | tr -d ' ')"
  med="$(tail -n +$((cut+1)) "$f" | grep -c ' medium$')"; low="$(tail -n +$((cut+1)) "$f" | grep -c ' low$')"
  if [ "$med" -ge "$BATCH_MEDIUM" ] || [ "$low" -ge "$BATCH_LOW" ]; then
    n="$(counter notes audit-number)"
    printf '**Risk:** high\nBatch audit #%s: review everything merged since the previous audit tag (audit-%s, or the start), with weight on these QA-only merges:\n%s\nFollow the batch method in docs/audit-patterns.md. Write the report to the audit report file; list needed fixes under "## Fix tasks".\n' \
      "$n" "$((n-1))" "$(tail -n +$((cut+1)) "$f" | sed 's/^/- /')" > "$STATE/notes/batch-$n.md"
    hk create "Batch audit #$n" --assignee auditor --workspace "dir:$REPO" --priority 8 --body-file "$STATE/notes/batch-$n.md" >/dev/null \
      && { echo "$total" > "$STATE/audit-cutoff"; log "created Batch audit #$n ($med medium, $low low)"; }
  fi
}

# ------------------------------------------------------------------ local job (background)
run_local() { # $1 role, $2 id
  local role="$1" id="$2" out rc a s new t f kind
  out="$("$REPO/bin/agent-step" "$role" "$id" 2>&1)"; rc=$?
  printf '%s\n' "$out" > "$STATE/notes/$id-last.txt"
  v() { printf '%s\n' "$out" | sed -n "s/^$1: //p" | tail -1; }
  a="$(v ACTION)"
  case "$a" in
    complete)
      hk complete "$id" --summary "$(v SUMMARY)" >/dev/null || hold "$id" DOCTOR "could not mark complete: $(v SUMMARY)"
      rm -f "$STATE/errors/$id"; log "complete $role $id: $(v SUMMARY)"
      [ "$role" = qa ] || [ "$role" = auditor ] && maybe_batch_audit ;;
    rework)
      kind="$(v KIND)"; t="$(v REWORK_TITLE)"; f="$(v REWORK_BODY_FILE)"
      if [ "$kind" = fail ] && [ "$(counter fails "$id")" -ge "$MAX_FAILS" ]; then
        hold "$id" DOCTOR "FAIL number $MAX_FAILS on this task: decide (split the task, rewrite the card, or change approach). Last findings: $f"
      else
        new="$(hk create "$t" --assignee dev --workspace "dir:$REPO" --priority 9 --body-file "$f" | grep -oE 't_[0-9a-f]+' | head -1)"
        if [ -n "$new" ]; then hk reclaim "$id" >/dev/null 2>&1; wait_on "$id" "$new" "$kind rework"
        else hold "$id" DOCTOR "could not create the $kind card ($t), body in $f"; fi
      fi ;;
    pause)
      s="$(v RESET)"; [ -z "$s" ] && s=$(( $(now) + 3600 ))
      echo "$s" > "$STATE/pro-paused-until"; hk reclaim "$id" >/dev/null 2>&1
      log "Pro limit reached ($role $id): Pro roles pause until $(date -r "$s" '+%H:%M' 2>/dev/null || date -d "@$s" '+%H:%M')" ;;
    question)
      hold "$id" DOCTOR "$(v QUESTION)" ;;
    *)
      if [ "$(counter errors "$id")" -ge "$LOCAL_MAX_TRIES" ]; then
        hold "$id" DOCTOR "$role run ended without a result $LOCAL_MAX_TRIES times (exit $rc), see data/dispatch/notes/$id-last.txt"
      else hk reclaim "$id" >/dev/null 2>&1; log "no result for $role $id (exit $rc): will retry"; fi ;;
  esac
}

# ------------------------------------------------------------------ cloud dev
start_cloud() { # $1 id, $2 attempt -> 0 started, 43 credit out, 1 failed
  local id="$1" n="$2" out rc url
  out="$("$REPO/bin/cloud-dev" "$id" "$n" 2>&1)"; rc=$?
  if [ $rc -eq 0 ]; then
    url="$(printf '%s' "$out" | sed -n 's/^SESSION //p')"
    printf 'attempt=%s\nstarted=%s\nurl=%s\n' "$n" "$(now)" "$url" > "$STATE/cloud/$id"
    hk comment "$id" "Cloud attempt $n started: $url" >/dev/null; log "cloud $id attempt $n: $url"; return 0
  fi
  [ $rc -eq 43 ] && { touch "$STATE/cloud-off"; log "cloud credit used up: the Dev now runs on Pro"; return 43; }
  log "cloud launch failed for $id: $(printf '%s' "$out" | tail -1)"; return 1
}
poll_cloud() {
  local f id n started url br ref subj hit=""
  git fetch -q --prune origin 2>/dev/null
  for f in "$STATE"/cloud/t_*; do
    [ -e "$f" ] || continue; id="$(basename "$f")"
    n="$(sed -n 's/^attempt=//p' "$f")"; started="$(sed -n 's/^started=//p' "$f")"; url="$(sed -n 's/^url=//p' "$f")"
    hit=""; br="$(dev_branch "$id")"
    for ref in "origin/$br" $(git for-each-ref --format='%(refname:short)' refs/remotes/origin | grep -v "^origin/$br\$"); do
      subj="$(git log -1 --format=%s "$ref" 2>/dev/null)"
      case "$subj" in "[$id] DONE"*|"[$id] BLOCKED"*) hit="$ref"; break ;; esac
    done
    if [ -n "$hit" ]; then
      subj="$(git log -1 --format=%s "$hit")"
      if [ "$hit" != "origin/$br" ]; then   # the session used its own branch name: move the work to the task branch
        gpush -q origin "refs/remotes/$hit:refs/heads/$br" && gpush -q origin --delete "${hit#origin/}" 2>/dev/null
        log "cloud $id: moved ${hit#origin/} to $br"
      fi
      hk comment "$id" "$(printf 'Cloud result (%s):\n\n%s\n\n%s' "$url" "$subj" "$(git log -1 --format=%b "$hit")")" >/dev/null
      rm -f "$f"
      case "$subj" in
        "[$id] DONE"*)    hk complete "$id" --summary "${subj#\[$id\] DONE: }" >/dev/null; log "complete dev $id (cloud): ${subj#\[$id\] DONE: }" ;;
        "[$id] BLOCKED"*) hold "$id" DOCTOR "cloud Dev asks: ${subj#\[$id\] BLOCKED: }" ;;
      esac
    elif [ $(( $(now) - started )) -gt $((CLOUD_TIMEOUT_MIN * 60)) ]; then
      if [ "$n" -lt "$CLOUD_MAX_TRIES" ]; then log "cloud $id attempt $n gave no result in ${CLOUD_TIMEOUT_MIN} min: next attempt"
        start_cloud "$id" $((n+1)) || true
      else rm -f "$f"; hold "$id" DOCTOR "$CLOUD_MAX_TRIES cloud attempts without a DONE commit (last session: $url). Check the branch $br and the card."; fi
    else
      hk heartbeat "$id" >/dev/null 2>&1 || true
    fi
  done
}

# ------------------------------------------------------------------ startup recovery
recover() {
  local id st role
  while read -r id st role; do
    [ "$st" = running ] || continue
    case "$ROLES" in *" $role "*) ;; *) continue ;; esac
    [ -f "$STATE/cloud/$id" ] && continue
    ls "$STATE/running" 2>/dev/null | grep -q "^$id\." && continue
    hk reclaim "$id" >/dev/null 2>&1; log "recovered orphaned running card $id ($role)"
  done <<EOF
$(board)
EOF
}

# ------------------------------------------------------------------ one pass
pass() {
  local f pid id st role B rc
  for f in "$STATE"/running/*; do [ -e "$f" ] || continue; pid="$(cat "$f")"; kill -0 "$pid" 2>/dev/null || rm -f "$f"; done
  [ -f "$STATE/pro-paused-until" ] && ! pro_paused && { rm -f "$STATE/pro-paused-until"; log "Pro limit reset: Pro roles resume"; }
  poll_cloud
  B="$(board)"
  while read -r id st role; do          # promote todo cards whose parents are done
    [ "$st" = todo ] || continue
    case "$ROLES" in *" $role "*) ;; *) continue ;; esac
    parents_done "$id" && { hk promote "$id" >/dev/null; log "promote $id ($role)"; }
  done <<EOF
$B
EOF
  B="$(board)"
  while read -r id st role; do          # start ready cards
    [ "$st" = ready ] || continue
    case "$ROLES" in *" $role "*) ;; *) continue ;; esac
    [ -f "$STATE/cloud/$id" ] && continue
    ls "$STATE/running" 2>/dev/null | grep -q "^$id\." && continue
    parents_done "$id" || continue
    if [ "$role" = dev ] && cloud_allowed && [ ! -f "$STATE/notes/$id.local" ]; then
      hk claim "$id" >/dev/null 2>&1 || { log "claim failed for $id"; continue; }
      start_cloud "$id" 1; rc=$?
      [ $rc -eq 0 ] && continue
      if [ $rc -ne 43 ]; then
        hk reclaim "$id" >/dev/null 2>&1
        [ "$(counter errors "$id")" -ge 3 ] && hold "$id" DOCTOR "the cloud session could not be started 3 times (see data/dispatch/dispatch.log)"
        continue
      fi
      hk reclaim "$id" >/dev/null 2>&1      # credit out: fall through to a local Pro run below on the next pass
      continue
    fi
    pro_paused && continue
    [ "$(local_count)" -ge "$MAX_PARALLEL" ] && break
    busy_role "$role" && continue
    hk claim "$id" >/dev/null 2>&1 || { log "claim failed for $id"; continue; }
    log "start $role $id (local, Pro)"
    ( run_local "$role" "$id" ) </dev/null >/dev/null 2>&1 &
    echo "$!" > "$STATE/running/$id.$role"
  done <<EOF
$B
EOF
}

# ------------------------------------------------------------------ main
if hermes gateway status </dev/null 2>/dev/null | grep -qiE "supervised by launchd \(PID|detached gateway process is running"; then
  echo "The Hermes gateway is running: stop it (hermes gateway stop). Its AI workers would also take cards." >&2; exit 2
fi
echo $$ > "$STATE/dispatch.pid"
log "dispatch started (cloud: $(cloud_allowed && echo on || echo off), max $MAX_PARALLEL local)"
recover
while :; do pass; [ $ONCE -eq 1 ] && break; sleep "$INTERVAL"; done
[ $ONCE -eq 1 ] && wait
