#!/usr/bin/env bash
# cc-route: run a Claude Code task on the owner's plan (local) while usage is
# below a threshold, and in a Claude Code cloud session (promo credit) above it.
#
#   bin/cc-route "<task prompt>"
#   bin/cc-route -f <prompt-file>
#
# Output starts with one line the caller must read:
#   [cc-route] LOCAL  -> task ran here; result is in the working tree
#   exit 42           -> plan limit hit and cloud not allowed (retry after reset)
#   [cc-route] CLOUD  -> task was handed to a cloud session; wait for its PR on GitHub
#
# Env overrides (optional):
#   CC_ROUTE_THRESHOLD   default 80   (% of 5h or 7d window that triggers cloud)
#   CC_ROUTE_CLOUD       default 1    (0 = never use cloud)
#   CC_ROUTE_CLOUD_UNTIL default 2026-11-05 (promo credit expiry; cloud off after this)
#   CC_ROUTE_FORCE       local|cloud  (testing only)
set -uo pipefail

if [ "${1:-}" = "-f" ]; then
  [ -f "${2:-}" ] || { echo "[cc-route] ERROR: prompt file not found: ${2:-}" >&2; exit 3; }
  PROMPT="$(cat "$2")"
else
  PROMPT="${1:?usage: cc-route \"<task prompt>\"  |  cc-route -f <prompt-file>}"
fi
THRESHOLD="${CC_ROUTE_THRESHOLD:-80}"
CLOUD_ENABLED="${CC_ROUTE_CLOUD:-1}"
CLOUD_UNTIL="${CC_ROUTE_CLOUD_UNTIL:-2026-11-05}"
CACHE="${CC_ROUTE_CACHE:-$HOME/.claude/usage-cache.json}"
MAX_AGE=$((60 * 60))   # usage readings older than 1h are treated as unknown
NOW=$(date +%s)

log() { echo "[cc-route] $*" >&2; }

command -v jq >/dev/null || { log "ERROR: jq is not installed (brew install jq). Usage-based routing needs it."; exit 3; }
command -v claude >/dev/null || { log "ERROR: claude (Claude Code) is not on PATH."; exit 3; }

cloud_allowed() {
  [ "$CLOUD_ENABLED" = "1" ] || return 1
  [[ "$(date +%Y-%m-%d)" < "$CLOUD_UNTIL" ]] || return 1
  return 0
}

# Prints the highest still-active usage %, or nothing if unknown.
current_usage() {
  [ -f "$CACHE" ] || return 0
  jq -r --argjson now "$NOW" --argjson maxage "$MAX_AGE" '
    def epoch(x):
      if (x|type) == "number" then x
      elif (x|type) == "string" then
        (x | sub("\\.[0-9]+"; "") | sub("Z$"; "+00:00")
           | capture("^(?<d>[0-9T:-]{19})(?<s>[+-])(?<h>[0-9]{2}):(?<m>[0-9]{2})$")
           | ((.d + "Z" | fromdateiso8601)
              - ((if .s == "+" then 1 else -1 end) * ((.h|tonumber)*3600 + (.m|tonumber)*60))))
          // null
      else null end;
    if (($now - (.updated_at // 0)) > $maxage) then empty
    else
      [ .rate_limits // {} | to_entries[] | .value
        | select(.used_percentage != null)
        | (epoch(.resets_at)) as $r
        | select($r == null or $r > $now)       # windows that already reset no longer count
        | .used_percentage ]
      | if length == 0 then 0 else max end
    end' "$CACHE" 2>/dev/null
}

run_local() {
  log "LOCAL"
  local out status
  out=$(claude -p "$PROMPT" --permission-mode acceptEdits 2>&1); status=$?
  printf '%s\n' "$out"
  if printf '%s' "$out" | grep -qiE "(usage|rate|session|weekly) limit|limit reached|hit your .*limit|out of (usage|credits)"; then
    return 42   # plan limit hit
  fi
  return $status
}

run_cloud() {
  log "CLOUD"
  # --cloud may require a TTY; `script` provides one on macOS.
  script -q /dev/null claude --cloud "$PROMPT"
}

case "${CC_ROUTE_FORCE:-}" in
  local) run_local; exit $? ;;
  cloud) run_cloud; exit $? ;;
esac

usage=$(current_usage)
if [ -n "$usage" ] && awk -v u="$usage" -v t="$THRESHOLD" 'BEGIN{exit !(u>=t)}' && cloud_allowed; then
  log "plan usage ${usage}% >= ${THRESHOLD}%"
  run_cloud; exit $?
fi
log "plan usage ${usage:-unknown}% < ${THRESHOLD}% (or cloud unavailable)"

run_local; status=$?
if [ $status -eq 42 ] && cloud_allowed; then
  log "plan limit hit during local run, retrying in cloud"
  run_cloud; exit $?
fi
exit $status
