#!/usr/bin/env bash
# bin/smoke [dir]: live smoke run of the pipeline on a temp DB with the EXAMPLE configs.
# Polls every public keyless source (incl. arbeitnow) and one public ATS board one by one (a failing source does not stop the others), then process + digest.
# web3career only runs when WEB3_CAREER_TOKEN is already set in the environment (never read from .env).
# linkedin_posts (Brave Search results, needs BRAVE_API_KEY) is polled too: without the key it prints its skip line. `yc` and `jobstreet`
# do not exist (their cards were dropped by the owner) and `threads` is not merged: they are added here when they land.
# After enrich, `resolve-apply --limit 3` runs (board lookups are paced at 1 request per 2 s, so a smoke run checks 3 postings; public ATS boards only; its Haiku step needs a key and prints its skip line without one).
# Never touches config/ or data/. JOB_AGENT_ENV_FILE=/dev/null stops the CLI from loading the owner's .env (and its API key); the key is also unset (so is BRAVE_API_KEY: linkedin_posts always shows its skip line). No LLM calls: if `enrich` exists it runs without a key, prints its skip line and the "scam rules checked N postings, suspicious M" line (text-only scam rules).
# bin/smoke --with-jobspy (flag first): also runs ONE LinkedIn and ONE Indeed search (results_wanted <= 10, logged out, via the JobSpy worker)
# when workers/jobspy/.venv exists. Not part of the default run: a block hurts the owner's home IP (agents only with owner OK).
# JOB_AGENT_CLI overrides the CLI command (used by tests).
#
# bin/smoke run <smoke dir> <command...>: run ONE more CLI command against an existing smoke dir (same temp DB and
# example configs, no API key), e.g. bin/smoke run /tmp/job-agent-smoke.ab12 process --reprocess
# Use this instead of prefixing commands with JOB_AGENT_DB=... (env-prefixed commands are not allowed for agents).
set -uo pipefail
REPO="$(git rev-parse --show-toplevel)"; cd "$REPO"
if [ "${1:-}" = run ]; then
  DIR="${2:?usage: bin/smoke run <smoke dir> <command...>}"; shift 2
  [ -f "$DIR/smoke.db" ] || { echo "no smoke.db in $DIR: run bin/smoke first"; exit 2; }
  [ $# -gt 0 ] || { echo "usage: bin/smoke run <smoke dir> <command...>"; exit 2; }
  export JOB_AGENT_DB="$DIR/smoke.db" JOB_AGENT_CONFIG_DIR="$DIR/config" JOB_AGENT_ENV_FILE=/dev/null; unset ANTHROPIC_API_KEY BRAVE_API_KEY
  read -r -a CLI <<< "${JOB_AGENT_CLI:-pnpm -s job-agent}"
  echo "== $* (smoke dir $DIR)"; exec "${CLI[@]}" "$@"
fi
WITH_JOBSPY=0
if [ "${1:-}" = --with-jobspy ]; then WITH_JOBSPY=1; shift; fi
DIR="${1:-$(mktemp -d "${TMPDIR:-/tmp}/job-agent-smoke.XXXXXX")}"
mkdir -p "$DIR/config" "$DIR/digests"
for f in config/*.example.*; do b="$(basename "$f")"; cp "$f" "$DIR/config/${b/.example/}"; done
export JOB_AGENT_DB="$DIR/smoke.db" JOB_AGENT_CONFIG_DIR="$DIR/config" JOB_AGENT_ENV_FILE=/dev/null
unset ANTHROPIC_API_KEY BRAVE_API_KEY
read -r -a CLI <<< "${JOB_AGENT_CLI:-pnpm -s job-agent}"

# Exactly one ATS board is polled: Greenhouse "gitlab" (a large public board, many postings from a single request;
# the Greenhouse adapter paces its own requests). It is written into the temp companies.yaml below, never read from config/.
printf 'companies:\n  - { name: GitLab, ats: greenhouse, slug: gitlab }\n' > "$DIR/config/companies.yaml"

SOURCES=(himalayas remoteok remotive weworkremotely hn arbeitnow greenhouse linkedin_posts)
if [ -n "${WEB3_CAREER_TOKEN:-}" ]; then SOURCES+=(web3career); else echo "web3career: skipped (WEB3_CAREER_TOKEN not set)"; fi

if [ "$WITH_JOBSPY" = 1 ]; then
  if [ -x "$REPO/workers/jobspy/.venv/bin/python" ]; then
    export JOB_AGENT_JOBSPY_SMOKE=1
    SOURCES+=(linkedin indeed)
  else echo "linkedin, indeed: skipped (workers/jobspy/.venv missing, see workers/jobspy/README.md)"; fi
fi

fail=0
step() { echo "== $*"; "${CLI[@]}" "$@" || { echo "!! '$*' exited $?"; return 1; }; }

step fx || true
for s in "${SOURCES[@]}"; do step discover --force --source "$s" || true; done
step process || fail=1
USAGE="$("${CLI[@]}" 2>&1)"
if grep -q '^  enrich$' <<< "$USAGE"; then step enrich || true; fi
if grep -q '^  resolve-apply$' <<< "$USAGE"; then step resolve-apply --limit 3 || true; fi
step digest --out-dir "$DIR/digests" || fail=1
echo "== status"
"${CLI[@]}" status || fail=1
echo "smoke dir: $DIR"
echo "digests: $DIR/digests"
exit "$fail"
