#!/usr/bin/env bash
# agent-step <role> <task-id>: one LOCAL run (Claude Code on the Pro plan) for qa | auditor | researcher | pm,
# and for dev only when the cloud is unavailable. Does all mechanical work as code and ends with ACTION lines
# that bin/dispatch acts on. It never blocks a card itself.
#
#   ACTION: complete   SUMMARY: ...
#   ACTION: rework     KIND: fail|sync   REWORK_TITLE: ...   REWORK_BODY_FILE: ...
#   ACTION: pause      RESET: <epoch or empty>          (Pro limit reached)
#   ACTION: question   QUESTION: ...                    (needs a decision: Doctor first, owner if it must be)
set -uo pipefail
. "$(dirname "$0")/lib.sh"
ROLE="${1:?role}"; ID="${2:?task id}"
case "$ROLE" in dev|qa|auditor|researcher|pm) ;; *) echo "unknown role $ROLE" >&2; exit 2 ;; esac
cd "$REPO"
H="$REPO/data/handoff"; mkdir -p "$H"
CARDF="$H/$ID-card.md"; PROMPTF="$H/$ID-prompt.md"; OUTF="$H/$ID-out.txt"; COMMENTF="$H/$ID-comment.md"; REPORTF="$H/$ID-report.md"
LOCK="$REPO/.git/agent-step.lock"

act()      { echo; echo "AGENT-STEP RESULT"; echo "ACTION: $1"; shift; for kv in "$@"; do echo "$kv"; done; exit 0; }
complete() { act complete "SUMMARY: $1"; }
question() { act question "QUESTION: $1"; }
lock_main(){ local i=0; until mkdir "$LOCK" 2>/dev/null; do i=$((i+1)); [ $i -gt 120 ] && question "main checkout lock stuck ($LOCK)"; sleep 5; done
             trap 'rmdir "$LOCK" 2>/dev/null' EXIT; }
unlock_main(){ rmdir "$LOCK" 2>/dev/null; trap - EXIT; }
main_ready(){ git checkout -q main 2>/dev/null || question "could not check out main in the repo"
              if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
                git stash push -q -m "agent-step $ID: owner's uncommitted changes" && log "stashed uncommitted changes in main for $ID (git stash list)"
              fi
              git pull -q --ff-only origin main || question "git pull on main failed (diverged?)"; }
post_comment(){ local f="$COMMENTF"; [ -s "$f" ] || { printf 'Report (no comment file), last lines:\n\n%s\n' "$(tail -40 "$OUTF")" > "$H/$ID-fallback.md"; f="$H/$ID-fallback.md"; }
                hk comment "$ID" "$(cat "$f")" >/dev/null; }
task_branch(){ local b; b="$(git branch --list "task/$1-*" --format='%(refname:short)' | head -1)"
               [ -z "$b" ] && b="$(git ls-remote --heads origin "task/$1-*" 2>/dev/null | awk '{print $2}' | sed 's#refs/heads/##' | head -1)"
               printf '%s' "$b"; }
squash_merge(){ # $1 branch, $2 commit title -> merged and pushed, or a sync rework
  local br="$1" ref cf
  lock_main; main_ready
  git fetch -q origin "$br" 2>/dev/null; ref="origin/$br"; git show-ref --quiet "refs/remotes/$ref" || ref="$br"
  if ! git merge -q --squash "$ref" >/dev/null 2>&1; then
    cf="$(git diff --name-only --diff-filter=U)"; git reset -q --hard HEAD; unlock_main; sync_rework "$br" "$cf"
  fi
  git diff --cached --quiet && { unlock_main; complete "Nothing to merge: $br is already in main"; }
  git commit -q -m "$2 ($ID, squash of $br)" || { git reset -q --hard HEAD; unlock_main; question "the squash commit of $br was refused by the pre-commit hook: see $OUTF"; }
  gpush -q origin main || { git reset -q --hard HEAD~1; unlock_main; question "push of main failed after merging $br"; }
}
sync_rework(){ # $1 branch, $2 conflicting files
  local f="$H/$ID-sync.md"
  { echo "Branch: $1"; echo; echo "**Risk:** high"; echo
    echo "The branch no longer merges cleanly with main. Conflicting files:"; printf '%s\n' "$2" | sed 's/^/- /'; echo
    echo "Merge origin/main into the branch, resolve every conflict (for source registries keep every entry from both sides),"
    echo "update tests affected by main, make pnpm check green. Review card waiting on this: $ID."; } > "$f"
  act rework "KIND: sync" "REWORK_TITLE: Sync with main: ${DEVTITLE:-$1}" "REWORK_BODY_FILE: $f"; }
fail_rework(){ local f="$H/$ID-rework.md"
  { echo "Branch: $BR"; echo; echo "**Risk:** high"; echo
    echo "Fix exactly the numbered findings below, re-run all checks, and address each finding by number."
    echo "Review card waiting on this: $ID."; echo; cat "$COMMENTF" 2>/dev/null || tail -60 "$OUTF"; } > "$f"
  act rework "KIND: fail" "REWORK_TITLE: Rework: ${DEVTITLE:-$BR}" "REWORK_BODY_FILE: $f"; }

card "$ID" > "$CARDF"; head -1 "$CARDF" | grep -q "^Task $ID" || question "could not read card $ID"
TITLE="$(head -1 "$CARDF" | sed -E "s/^Task $ID: //")"
RISK="$(grep -m1 -oiE '\*\*Risk:\*\* *(high|medium|low)' "$CARDF" | grep -oiE 'high|medium|low' | tr 'A-Z' 'a-z')"
PARENTS="$(field "$(cat "$CARDF")" parents | tr ',' ' ')"
rm -f "$COMMENTF" "$REPORTF"
WORKDIR="$REPO"; BR="-"; DEVTITLE=""; REVIEW_WT=""; NOTE=""

# ------------------------------------------------------------------ prepare the work dir
if [ "$ROLE" = dev ]; then
  BR="$(dev_branch "$ID")"; git fetch -q origin 2>/dev/null
  WORKDIR="$(git worktree list --porcelain | awk -v b="refs/heads/$BR" '/^worktree /{p=$2} $0=="branch "b{print p; exit}')"
  if [ -z "$WORKDIR" ]; then
    WORKDIR="$REPO/.worktrees/$(printf '%s' "$BR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"
    if git show-ref --quiet "refs/heads/$BR"; then git worktree add -q "$WORKDIR" "$BR"
    elif git show-ref --quiet "refs/remotes/origin/$BR"; then git worktree add -q "$WORKDIR" -b "$BR" "origin/$BR"
    else git worktree add -q "$WORKDIR" -b "$BR" origin/main; fi || question "could not create the worktree for $BR"
  fi
  git -C "$WORKDIR" pull -q --ff-only origin "$BR" 2>/dev/null
  if ! git -C "$WORKDIR" merge -q --no-edit origin/main >/dev/null 2>&1; then
    CF="$(git -C "$WORKDIR" diff --name-only --diff-filter=U)"
    [ -n "$CF" ] && NOTE="origin/main was merged into this branch and has CONFLICTS in: $(printf '%s' "$CF" | tr '\n' ' '). Resolve them first (keep every registry entry from both sides), then commit the merge." \
                 || git -C "$WORKDIR" merge --abort 2>/dev/null
  fi
elif [ "$ROLE" = qa ] || [ "$ROLE" = auditor ]; then
  for p in $PARENTS; do BR="$(task_branch "$p")"; [ -n "$BR" ] && break; done
  if [ -z "$BR" ]; then for p in $PARENTS; do for gp in $(field "$(card "$p")" parents | tr ',' ' '); do
      BR="$(task_branch "$gp")"; [ -n "$BR" ] && break 2; done; done; fi
  git fetch -q origin 2>/dev/null; REVIEW_WT="$REPO/.worktrees/$ID-review"; git worktree remove --force "$REVIEW_WT" 2>/dev/null
  if [ -n "$BR" ]; then
    DEVTITLE="$(title_of "$(printf '%s' "$BR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')")"
    REF="$BR"; git show-ref --quiet "refs/remotes/origin/$BR" && REF="origin/$BR"
    git worktree add -q --detach "$REVIEW_WT" "$REF" || question "could not create a review checkout of $BR"
    if ! git -C "$REVIEW_WT" -c user.name=agent-step -c user.email=agent-step@local merge -q --no-edit origin/main >/dev/null 2>&1; then
      CF="$(git -C "$REVIEW_WT" diff --name-only --diff-filter=U)"; git -C "$REVIEW_WT" merge --abort 2>/dev/null
      git worktree remove --force "$REVIEW_WT" 2>/dev/null; [ -n "$CF" ] && sync_rework "$BR" "$CF"
      question "could not merge origin/main into the review checkout of $BR"
    fi
  elif [ "$ROLE" = auditor ]; then
    BR="-"; git worktree add -q --detach "$REVIEW_WT" origin/main || question "could not check out origin/main for the audit"
  else
    question "no dev branch found for this QA card (parents: $PARENTS). If the work was done another way, close this card."
  fi
  WORKDIR="$REVIEW_WT"
fi

# ------------------------------------------------------------------ prompt + run
{ echo "Role: $ROLE"; echo "Task: $ID"; echo "Repo root: $REPO"; echo "Work dir: $WORKDIR"
  [ "$ROLE" = dev ] && echo "Branch: $BR"
  [ -n "$REVIEW_WT" ] && [ "$BR" != "-" ] && echo "Reviewing branch: $BR (merged with current origin/main, detached checkout)"
  [ -n "$REVIEW_WT" ] && [ "$BR" = "-" ] && echo "Reviewing: origin/main (batch / phase-end audit)"
  [ "$ROLE" = auditor ] && echo "Audit report file: $REPORTF"
  [ -n "$NOTE" ] && echo "$NOTE"
  echo "Comment file: $COMMENTF"; echo
  cat prompts/roles/common.md "prompts/roles/$ROLE.md"; echo; echo "## Task card"; cat "$CARDF"
} > "$PROMPTF"
log "agent-step: $ROLE $ID running Claude Code (Pro, model ${ROLE})"
"$REPO/bin/cc-run" "$ROLE" "$WORKDIR" "$PROMPTF" "$OUTF"; RC=$?
[ -n "$REVIEW_WT" ] && git worktree remove --force "$REVIEW_WT" 2>/dev/null
[ $RC -eq 42 ] && act pause "RESET: $(sed -n 's/^LIMIT_RESET_EPOCH=//p' "$OUTF" | tail -1)"

VLINE="$(grep '^VERDICT:' "$OUTF" | tail -1)"
[ -z "$VLINE" ] && { echo "no verdict (exit $RC)"; tail -5 "$OUTF"; exit 1; }    # dispatcher retries, then the Doctor
VERDICT="$(printf '%s' "$VLINE" | sed -E 's/^VERDICT: *([A-Z]+).*/\1/')"
VSUM="$(printf '%s' "$VLINE" | awk -F'|' '{print $NF}' | sed -E 's/^ +//; s/ +$//')"
post_comment
[ "$VERDICT" = BLOCKED ] && question "$VSUM"

# ------------------------------------------------------------------ act on the verdict
case "$ROLE" in
  dev)
    [ "$VERDICT" = DONE ] || question "unexpected verdict $VERDICT from the dev run"
    gpush -q -u origin "$BR" 2>/dev/null || gpush -q -u origin "$BR" || question "could not push $BR"
    complete "$VSUM" ;;
  qa)
    [ "$VERDICT" = FAIL ] && fail_rework
    [ "$VERDICT" = PASS ] || question "unexpected verdict $VERDICT from QA"
    [ "$RISK" = high ] && complete "QA PASS (high risk, the auditor merges): $VSUM"
    DEVID="$(printf '%s' "$BR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"
    squash_merge "$BR" "${DEVTITLE:-Merge $BR}"
    printf '| %s | %s | %s | %s | %s |\n' "$DEVID" "${DEVTITLE:-$BR}" "${RISK:-medium}" "$(git rev-parse --short HEAD)" "$(date +%F)" >> docs/audit-ledger.md
    git add docs/audit-ledger.md && git commit -q -m "chore: audit ledger $DEVID" && gpush -q origin main
    echo "$DEVID ${RISK:-medium}" >> "$STATE/merged.log"
    git worktree remove --force ".worktrees/$DEVID" 2>/dev/null; git branch -q -D "$BR" 2>/dev/null; gpush -q origin --delete "$BR" 2>/dev/null
    unlock_main; complete "QA PASS, merged $BR: $VSUM" ;;
  auditor)
    if [ "$BR" != "-" ]; then
      [ "$VERDICT" = FAIL ] && fail_rework
      [ "$VERDICT" = PASS ] || question "unexpected verdict $VERDICT from the auditor"
      DEVID="$(printf '%s' "$BR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"
      squash_merge "$BR" "${DEVTITLE:-Merge $BR}"
      echo "$DEVID high" >> "$STATE/merged.log"
      git worktree remove --force ".worktrees/$DEVID" 2>/dev/null; git branch -q -D "$BR" 2>/dev/null; gpush -q origin --delete "$BR" 2>/dev/null
      unlock_main; complete "Audit PASS, merged $BR: $VSUM"
    fi
    lock_main; main_ready
    N="$(printf '%s' "$TITLE" | grep -oE '#[0-9]+' | tr -d '#' | head -1)"
    if [ -s "$REPORTF" ]; then mkdir -p docs/audits
      case "$TITLE" in *[Pp]hase*) cp "$REPORTF" "docs/audits/phase-${N:-x}.md" ;; *) cp "$REPORTF" "docs/audits/batch-${N:-$ID}.md" ;; esac; fi
    git add docs/audits 2>/dev/null; git diff --cached --quiet || git commit -q -m "docs: audit report ($ID)"
    [ -n "$N" ] && git tag -f "audit-$N" >/dev/null 2>&1
    gpush -q origin main --tags 2>/dev/null || gpush -q origin main
    unlock_main; complete "Audit $VERDICT: $VSUM (fix tasks, if any, are listed in the report)" ;;
  researcher|pm)
    [ "$VERDICT" = DONE ] || question "unexpected verdict $VERDICT from the $ROLE run"
    lock_main; main_ready
    if [ "$ROLE" = researcher ]; then git add docs/research 2>/dev/null; else git add docs 2>/dev/null; fi
    if ! git diff --cached --quiet; then
      git commit -q -m "docs($ROLE): $ID" || { git reset -q; unlock_main; question "the pre-commit hook refused the $ROLE docs: see $OUTF"; }
      gpush -q origin main || { unlock_main; question "push of the $ROLE docs failed"; }
    fi
    unlock_main; complete "$VSUM" ;;
esac
