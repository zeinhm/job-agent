#!/usr/bin/env bash
# agent-step: run one Hermes board task through Claude Code, as plain code.
#
#   bin/agent-step <role> <task-id>        role: dev | qa | auditor | researcher | pm
#
# Does every mechanical step deterministically: saves the card, prepares the
# worktree (dev), builds the prompt, runs bin/cc-route, reads the verdict,
# posts the report as a comment, and does the git work (push / merge / ledger /
# cleanup / commit docs). The calling Hermes agent only acts on the last lines:
#
#   ACTION: complete            -> complete the task, SUMMARY is the summary
#   ACTION: block               -> block the task, REASON is the reason
#
# Written for macOS bash 3.2 (no bash 4 features).
set -uo pipefail

ROLE="${1:?usage: agent-step <dev|qa|auditor|researcher|pm> <task-id>}"
ID="${2:?usage: agent-step <dev|qa|auditor|researcher|pm> <task-id>}"
case "$ROLE" in dev|qa|auditor|researcher|pm) ;; *) echo "unknown role: $ROLE" >&2; exit 2 ;; esac

REPO="$(git rev-parse --show-toplevel)" || exit 2
cd "$REPO"
H="$REPO/data/handoff"; mkdir -p "$H"
CARDF="$H/$ID-card.md"; PROMPTF="$H/$ID-prompt.md"; OUTF="$H/$ID-out.txt"; COMMENTF="$H/$ID-comment.md"
LOCK="$REPO/.git/agent-step.lock"

finish() { # $1=complete|block  $2=text
  echo
  echo "AGENT-STEP RESULT"
  echo "ACTION: $1"
  if [ "$1" = complete ]; then echo "SUMMARY: $2"; else echo "REASON: $2"; fi
  exit 0
}
lock_main() { # serialize work in the main checkout across agents (max 10 min wait)
  local i=0
  until mkdir "$LOCK" 2>/dev/null; do
    i=$((i+1)); [ $i -gt 120 ] && finish block "HUMAN: main checkout lock busy for 10 min ($LOCK); remove it if no agent is running"
    sleep 5
  done
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT
}
unlock_main() { rmdir "$LOCK" 2>/dev/null; trap - EXIT; }
gpush() { # git with the repo token from the macOS Keychain, for this one command only (same as the owner's jpush).
  # The token never enters the environment that Claude Code runs in.
  local tok=""
  command -v security >/dev/null 2>&1 && tok="$(security find-generic-password -a "${USER:-$(id -un)}" -s "${AGENT_STEP_KEYCHAIN_SERVICE:-job-agent-github-token}" -w 2>/dev/null)"
  JOB_AGENT_GITHUB_TOKEN="${tok:-${JOB_AGENT_GITHUB_TOKEN:-}}" git "$@"
}
push_or_block() { # $1 = block reason, rest = git args. Pushes with gpush; on failure blocks with git's last error line.
  local msg="$1" out; shift
  out="$(gpush "$@" 2>&1)" && return 0
  finish block "$msg: $(printf '%s\n' "$out" | grep -v '^ *$' | tail -1)"
}
only_amended_on_remote() { # $1 = remote sha. True when every commit that exists only on the remote has a twin
  # (same author + subject) in the local branch, i.e. the local branch amended/rebased it rather than missing new work.
  local c twins
  twins="$(git -C "$WORKDIR" log --format='%ae %s' HEAD --not "$1")"
  for c in $(git -C "$WORKDIR" rev-list "$1" --not HEAD); do
    printf '%s\n' "$twins" | grep -qxF "$(git -C "$WORKDIR" log -1 --format='%ae %s' "$c")" || return 1
  done
}
push_task_branch() { # pushes $BR from $WORKDIR; uses --force-with-lease only when the remote holds amended copies
  local out rsha
  out="$(gpush -C "$WORKDIR" push -q -u origin "$BR" 2>&1)" && return 0
  gpush -C "$WORKDIR" fetch -q origin "$BR" 2>/dev/null
  rsha="$(git -C "$WORKDIR" rev-parse -q --verify "refs/remotes/origin/$BR")"
  if [ -n "$rsha" ] && ! git -C "$WORKDIR" merge-base --is-ancestor "$rsha" HEAD; then
    if only_amended_on_remote "$rsha"; then
      out="$(gpush -C "$WORKDIR" push -q -u --force-with-lease="$BR:$rsha" origin "$BR" 2>&1)" \
        && { echo "[agent-step] force-pushed $BR: remote tip $rsha was amended locally"; return 0; }
    else
      finish block "HUMAN: could not push $BR: the remote branch has commits that are not in the local branch (e.g. a cloud session pushed). Pull them into the worktree or push by hand"
    fi
  fi
  finish block "HUMAN: could not push $BR: $(printf '%s\n' "$out" | grep -v '^ *$' | tail -1)"
}
main_clean_or_block() {
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    finish block "HUMAN: the main checkout has uncommitted changes; commit or stash them, then unblock"
  fi
}
post_comment() {
  if [ -s "$COMMENTF" ]; then
    hermes kanban comment "$ID" "$(cat "$COMMENTF")" >/dev/null 2>&1 || echo "[agent-step] warning: could not post comment"
  else
    hermes kanban comment "$ID" "$(printf 'Claude Code report (comment file missing), last lines:\n\n%s' "$(tail -40 "$OUTF")")" >/dev/null 2>&1 || true
  fi
}
rework() { # $1 = title, $2 = body file, $3 = reason. Asks the wrapper agent to create a dev card and wait on it.
  echo
  echo "AGENT-STEP RESULT"
  echo "ACTION: rework"
  echo "REWORK_TITLE: $1"
  echo "REWORK_BODY_FILE: $2"
  echo "REASON: $3"
  exit 0
}
wt_for_branch() { # prints the worktree path where branch $1 is checked out, if any
  git worktree list --porcelain | awk -v b="refs/heads/$1" '/^worktree /{p=$2} $0=="branch "b{print p; exit}'
}
sync_card() { # $1 = branch, $2 = conflicting files. Creates a "sync with main" rework (not counted as a FAIL).
  local f="$H/$ID-sync.md" dt
  dt="$(printf '%s' "$1" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"
  {
    echo "Branch: $1"; echo
    echo "**Risk:** high"; echo
    echo "The branch no longer merges cleanly with main. Conflicting files:"
    printf '%s\n' "$2" | sed 's/^/- /'; echo
    echo "Merge origin/main into the branch, resolve every conflict (for source registries keep every entry from both sides),"
    echo "update tests that changed because of main, re-run \`pnpm check\`, commit the merge and report evidence."
    echo "Original dev task: ${dt:-unknown}. QA card waiting on this: $ID."
  } > "$f"
  rework "Sync with main: ${DEVTITLE:-$1}" "$f" "SYNC: waiting on sync card for $1"
}
merge_branch() { # $1 = branch; merges into main and pushes. Blocks on any problem.
  local br="$1"
  lock_main
  main_clean_or_block
  git checkout -q main || finish block "HUMAN: could not check out main"
  git pull -q --ff-only origin main || finish block "HUMAN: git pull on main failed (diverged?)"
  git fetch -q origin "$br" 2>/dev/null || true
  local ref="$br"; git show-ref --quiet "refs/heads/$br" || ref="origin/$br"
  # squash: main only ever receives the final state of the branch, never its intermediate commits
  # (so anything fixed by a rework, e.g. a leaked value, never enters main's history)
  if ! git merge -q --squash "$ref" >/dev/null 2>&1; then
    local cf; cf="$(git diff --name-only --diff-filter=U)"
    git reset -q --hard HEAD; unlock_main
    [ -n "$cf" ] && sync_card "$br" "$cf"
    finish block "HUMAN: squash merge of $br failed"
  fi
  git diff --cached --quiet && { unlock_main; finish block "HUMAN: $br has nothing to merge (already in main?)"; }
  git commit -q -m "${MERGE_TITLE:-Merge $br} ($ID, squash of $br)" || { git reset -q --hard HEAD; unlock_main; finish block "HUMAN: squash commit of $br was refused (pre-commit hook?), see data/handoff/$ID-out.txt"; }
}
cleanup_branch() { # $1 = branch, $2 = dev task id
  git worktree remove --force ".worktrees/$2" 2>/dev/null
  git worktree remove --force ".worktrees/$2-review" 2>/dev/null
  git branch -q -D "$1" 2>/dev/null
  gpush push -q origin --delete "$1" 2>/dev/null || true
}

# ---------------------------------------------------------------- card
hermes kanban show "$ID" > "$CARDF" 2>/dev/null || finish block "HUMAN: could not read task $ID"
TITLE="$(head -1 "$CARDF" | sed -E "s/^Task $ID: //")"
MAX_FAILS="${AGENT_STEP_MAX_FAILS:-3}"
PREV_FAILS="$(grep -c 'FAIL: waiting on rework card' "$CARDF" 2>/dev/null || true)"
REWORK_DEPTH="$(printf '%s' "$(head -1 "$CARDF")" | grep -o 'Rework' | wc -l | tr -d ' ')"
fail_or_stop() { # FAIL verdict: ask the wrapper to create a rework card, or stop the loop
  if [ "$PREV_FAILS" -ge $((MAX_FAILS - 1)) ]; then
    finish block "HUMAN: FAIL number $((PREV_FAILS + 1)) on this task (limit $MAX_FAILS). Stopping the rework loop: decide whether to fix it yourself, change the task, or drop it"
  fi
  local f="$H/$ID-rework.md"
  { echo "Branch: $VBR"; echo; echo "**Risk:** high"; echo; echo "Fix exactly the numbered findings below, re-run all checks, and address each finding by number in the evidence."
    echo "Review card waiting on this: $ID."; echo; cat "$COMMENTF" 2>/dev/null || tail -60 "$OUTF"; } > "$f"
  rework "Rework: ${DEVTITLE:-$VBR}" "$f" "FAIL: waiting on rework card (cycle $((PREV_FAILS + 1)) of $MAX_FAILS)"
}
RISK="$(grep -m1 -oiE '\*\*Risk:\*\* *(high|medium|low)' "$CARDF" | grep -oiE 'high|medium|low' | tr 'A-Z' 'a-z')"
PARENTS="$(sed -n 's/^ *parents: *//p' "$CARDF" | tr ',' ' ')"
rm -f "$COMMENTF"

if [ "$ROLE" = dev ] && [ "$REWORK_DEPTH" -ge 3 ]; then
  finish block "HUMAN: rework of a rework of a rework ($TITLE). Stopping the loop: needs a human decision"
fi

# ---------------------------------------------------------------- work dir
WORKDIR="$REPO"; CLOUD=0; BR="-"; PREFER=""
if [ "$ROLE" = dev ]; then
  CLOUD=1
  BR="$(git branch --list "task/$ID-*" --format='%(refname:short)' | head -1)"
  [ -z "$BR" ] && BR="$(git ls-remote --heads origin "task/$ID-*" 2>/dev/null | awk '{print $2}' | sed 's#refs/heads/##' | head -1)"
  # rework / sync cards continue on the original dev branch named in the card ("Branch: task/...")
  [ -z "$BR" ] && BR="$(grep -m1 -oE 'Branch: *task/t_[0-9a-f]+-[A-Za-z0-9._-]+' "$CARDF" | sed -E 's/^Branch: *//')"
  if [ -z "$BR" ]; then
    SLUG="$(printf '%s' "$TITLE" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-30 | sed -E 's/-+$//')"
    BR="task/$ID-${SLUG:-work}"
  fi
  git fetch -q origin 2>/dev/null || true
  # dev prefers the cloud credit, except when resuming: a branch already on origin with commits
  # main lacks may hold a running/finished cloud session, so go local-first and never start a second one
  PREFER=cloud
  if git show-ref --quiet "refs/remotes/origin/$BR" && [ "$(git rev-list --count "origin/main..origin/$BR" 2>/dev/null || echo 0)" -gt 0 ]; then
    PREFER=""
  fi
  WORKDIR="$(wt_for_branch "$BR")"
  if [ -z "$WORKDIR" ]; then
    WTID="$(printf '%s' "$BR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"; WORKDIR="$REPO/.worktrees/${WTID:-$ID}"
    if git show-ref --quiet "refs/heads/$BR"; then git worktree add -q "$WORKDIR" "$BR"
    elif git show-ref --quiet "refs/remotes/origin/$BR"; then git worktree add -q "$WORKDIR" -b "$BR" "origin/$BR"
    else git worktree add -q "$WORKDIR" -b "$BR" origin/main 2>/dev/null || git worktree add -q "$WORKDIR" -b "$BR" main
    fi || finish block "HUMAN: could not create worktree for $BR"
  fi
  git -C "$WORKDIR" pull -q --ff-only origin "$BR" 2>/dev/null || true   # picks up a finished cloud session
  # keep the branch current with main; leave conflicts for Claude Code to resolve
  SYNC_NOTE=""
  if ! git -C "$WORKDIR" merge -q --no-edit origin/main >/dev/null 2>&1; then
    CONFL="$(git -C "$WORKDIR" diff --name-only --diff-filter=U)"
    if [ -n "$CONFL" ]; then
      SYNC_NOTE="IMPORTANT: origin/main was just merged into this branch and has CONFLICTS in: $(printf '%s' "$CONFL" | tr '\n' ' '). Resolve them first (for source registries keep every entry from both sides), update affected tests, then commit the merge."
    else
      git -C "$WORKDIR" merge --abort 2>/dev/null
    fi
  fi
fi

find_task_branch() { # $1 = task id -> prints task/<id>-* branch (local or on origin)
  local b
  b="$(git branch --list "task/$1-*" --format='%(refname:short)' | head -1)"
  [ -z "$b" ] && b="$(git ls-remote --heads origin "task/$1-*" 2>/dev/null | awk '{print $2}' | sed 's#refs/heads/##' | head -1)"
  printf '%s' "$b"
}
REVIEW_WT=""
if [ "$ROLE" = qa ] || [ "$ROLE" = auditor ]; then
  REVIEW_BR=""
  for p in $PARENTS; do REVIEW_BR="$(find_task_branch "$p")"; [ -n "$REVIEW_BR" ] && break; done
  if [ -z "$REVIEW_BR" ]; then   # e.g. auditor card whose parent is the QA card: look one level further
    for p in $PARENTS; do
      for gp in $(hermes kanban show "$p" 2>/dev/null | sed -n 's/^ *parents: *//p' | tr ',' ' '); do
        REVIEW_BR="$(find_task_branch "$gp")"; [ -n "$REVIEW_BR" ] && break 2
      done
    done
  fi
  git fetch -q origin 2>/dev/null || true
  REVIEW_WT="$REPO/.worktrees/$ID-review"
  git worktree remove --force "$REVIEW_WT" 2>/dev/null
  if [ -n "$REVIEW_BR" ]; then
    REF="$REVIEW_BR"; git show-ref --quiet "refs/remotes/origin/$REVIEW_BR" && REF="origin/$REVIEW_BR"
    git worktree add -q --detach "$REVIEW_WT" "$REF" || finish block "HUMAN: could not create review worktree for $REVIEW_BR"
    BR="$REVIEW_BR"
    DEVTITLE="$(hermes kanban show "$(printf '%s' "$BR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')" 2>/dev/null | head -1 | sed -E 's/^Task [^:]*: //')"
    # review what main will actually get: the branch merged with current main
    if ! git -C "$REVIEW_WT" -c user.name=agent-step -c user.email=agent-step@local merge -q --no-edit origin/main >/dev/null 2>&1; then
      CONFL="$(git -C "$REVIEW_WT" diff --name-only --diff-filter=U)"
      git -C "$REVIEW_WT" merge --abort 2>/dev/null; git worktree remove --force "$REVIEW_WT" 2>/dev/null
      [ -n "$CONFL" ] && sync_card "$BR" "$CONFL"
      finish block "HUMAN: could not merge origin/main into the review checkout of $BR"
    fi
  elif [ "$ROLE" = auditor ]; then   # batch / phase-end audit: review current origin/main
    git worktree add -q --detach "$REVIEW_WT" origin/main || finish block "HUMAN: could not create audit worktree of origin/main"
  else
    finish block "HUMAN: QA could not find the dev branch for this card (parents: $PARENTS)"
  fi
  WORKDIR="$REVIEW_WT"
fi
REPORTF="$H/$ID-report.md"; rm -f "$REPORTF"

# ---------------------------------------------------------------- prompt
{
  echo "Role: $ROLE"; echo "Task: $ID"; echo "Repo root: $REPO"; echo "Work dir: $WORKDIR"
  [ "$ROLE" = dev ] && echo "Branch: $BR"
  [ -n "${SYNC_NOTE:-}" ] && echo "$SYNC_NOTE"
  [ -n "$REVIEW_WT" ] && [ "$BR" != "-" ] && echo "Reviewing branch: $BR (you are already in a detached review worktree of it)"
  [ -n "$REVIEW_WT" ] && [ "$BR" = "-" ] && echo "Reviewing: origin/main (batch / phase-end audit; detached worktree)"
  [ "$ROLE" = auditor ] && echo "Audit report file: $REPORTF"
  echo "Comment file: $COMMENTF"; echo
  cat prompts/roles/common.md "prompts/roles/$ROLE.md"; echo
  echo "## Task card"; cat "$CARDF"
} > "$PROMPTF"

# ---------------------------------------------------------------- run Claude Code
echo "[agent-step] $ROLE $ID: running Claude Code (this can take a while)..."
( cd "$WORKDIR" && CC_ROUTE_CLOUD=$CLOUD CC_ROUTE_PREFER=$PREFER "$REPO/bin/cc-route" -f "$PROMPTF" ) > "$OUTF" 2>&1
RC=$?
[ -n "$REVIEW_WT" ] && git worktree remove --force "$REVIEW_WT" 2>/dev/null
echo "[agent-step] cc-route exit=$RC"; tail -3 "$OUTF"

if grep -q '\[cc-route\] CLOUD$' "$OUTF" && ! grep -q 'CLOUD_FAILED' "$OUTF" && [ $RC -eq 0 ]; then
  URL="$(grep -oE 'https://claude\.ai/code/[^ )]+' "$OUTF" | head -1)"
  hermes kanban comment "$ID" "Running in a Claude Code cloud session: ${URL:-see data/handoff/$ID-out.txt}" >/dev/null 2>&1 || true
  finish block "CLOUD: waiting for the cloud session's PR (${URL:-no url}); unblock to resume"
fi
if [ $RC -eq 42 ] || grep -qiE "(usage|rate|session|weekly) limit|limit reached|hit your .*limit" "$OUTF"; then
  RESET="$(grep -oiE 'resets? [^.)]*' "$OUTF" | head -1)"
  finish block "LIMIT: Claude Code plan limit reached${RESET:+ ($RESET)}; unblock after the reset"
fi
[ $RC -eq 3 ] && finish block "HUMAN: cc-route setup error: $(grep -m1 ERROR "$OUTF")"

VLINE="$(grep '^VERDICT:' "$OUTF" | tail -1)"
[ -z "$VLINE" ] && { post_comment; finish block "HUMAN: Claude Code returned no verdict, see data/handoff/$ID-out.txt"; }
VERDICT="$(printf '%s' "$VLINE" | sed -E 's/^VERDICT: *([A-Z]+).*/\1/')"
VBR="$(printf '%s' "$VLINE" | sed -nE 's/.*\| *branch: *([^ |]+).*/\1/p')"
VSUM="$(printf '%s' "$VLINE" | awk -F'|' '{print $NF}' | sed -E 's/^ +//; s/ +$//')"
post_comment
{ [ -z "$VBR" ] || [ "$VBR" = "-" ]; } && [ -n "$REVIEW_WT" ] && VBR="$BR"

[ "$VERDICT" = BLOCKED ] && finish block "HUMAN: $VSUM"

# ---------------------------------------------------------------- role actions
case "$ROLE" in
  dev)
    [ "$VERDICT" = DONE ] || finish block "HUMAN: unexpected verdict $VERDICT"
    push_task_branch
    finish complete "$VSUM" ;;

  qa)
    [ "$VERDICT" = FAIL ] && fail_or_stop
    [ "$VERDICT" = PASS ] || finish block "HUMAN: unexpected verdict $VERDICT"
    [ "$RISK" = high ] && finish complete "QA PASS (high risk, auditor next): $VSUM"
    [ -z "$VBR" ] || [ "$VBR" = "-" ] && finish block "HUMAN: QA PASS but no branch in the verdict"
    DEVID="$(printf '%s' "$VBR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"
    DEVTITLE="$(hermes kanban show "$DEVID" 2>/dev/null | head -1 | sed -E "s/^Task $DEVID: //")"
    MERGE_TITLE="${DEVTITLE:-}" merge_branch "$VBR"
    printf '| %s | %s | %s | %s | %s |\n' "$DEVID" "${DEVTITLE:-$VBR}" "${RISK:-medium}" "$(git rev-parse --short HEAD)" "$(date +%F)" >> docs/audit-ledger.md
    git add docs/audit-ledger.md && git commit -q -m "chore: audit ledger $DEVID" || true
    push_or_block "HUMAN: merged locally but push of main failed" push -q origin main
    cleanup_branch "$VBR" "$DEVID"; unlock_main
    finish complete "QA PASS, merged $VBR: $VSUM" ;;

  auditor)
    if [ -n "$VBR" ] && [ "$VBR" != "-" ]; then   # individual audit of a task branch
      [ "$VERDICT" = FAIL ] && fail_or_stop
      [ "$VERDICT" = PASS ] || finish block "HUMAN: unexpected verdict $VERDICT"
      DEVID="$(printf '%s' "$VBR" | sed -nE 's#^task/(t_[0-9a-f]+)-.*#\1#p')"
      merge_branch "$VBR"
      push_or_block "HUMAN: merged locally but push of main failed" push -q origin main
      cleanup_branch "$VBR" "$DEVID"; unlock_main
      finish complete "Audit PASS, merged $VBR: $VSUM"
    fi
    # batch / phase-end audit: commit the report (+ ledger), tag, push
    lock_main; main_clean_or_block
    git checkout -q main && git pull -q --ff-only origin main || finish block "HUMAN: could not update main"
    N="$(printf '%s' "$TITLE" | grep -oE '#[0-9]+' | tr -d '#' | head -1)"
    if [ -s "$REPORTF" ]; then
      mkdir -p docs/audits
      case "$TITLE" in *[Pp]hase*) cp "$REPORTF" "docs/audits/phase-${N:-x}.md" ;; *) cp "$REPORTF" "docs/audits/batch-${N:-$ID}.md" ;; esac
    fi
    git add docs/audits/ docs/audit-ledger.md 2>/dev/null
    git commit -q -m "docs: audit report ($ID)" || true
    [ -n "$N" ] && git tag "audit-$N" 2>/dev/null
    push_or_block "HUMAN: push of the audit report failed" push -q origin main --tags
    unlock_main
    finish complete "Audit $VERDICT: $VSUM" ;;

  researcher|pm)
    [ "$VERDICT" = DONE ] || finish block "HUMAN: unexpected verdict $VERDICT"
    lock_main; main_clean_or_block
    git checkout -q main && git pull -q --ff-only origin main || finish block "HUMAN: could not update main"
    if [ "$ROLE" = researcher ]; then git add docs/research/ 2>/dev/null; else git add docs/ 2>/dev/null; fi
    if ! git diff --cached --quiet; then
      git commit -q -m "docs($ROLE): $ID" || finish block "HUMAN: commit blocked (pre-commit hook?), see data/handoff/$ID-out.txt"
      push_or_block "HUMAN: push of docs failed" push -q origin main
    fi
    unlock_main
    finish complete "$VSUM" ;;
esac
