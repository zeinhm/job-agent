#!/usr/bin/env bash
# cc-run <role> <workdir> <prompt-file> <out-file>: one local Claude Code run on the Pro plan,
# with the role's model (bin/jobagent.conf) and permissions (.claude/roles/<role>.json, merged with the
# private ~/.config/job-agent/claude-overrides.json if present; both permissions.deny lists are kept).
# Exit 42 = Pro limit reached (the out-file's last line is "LIMIT_RESET_EPOCH=<epoch or empty>").
set -uo pipefail
. "$(dirname "$0")/lib.sh"
ROLE="$1"; WD="$2"; PF="$3"; OUT="$4"; SESSF="${5:-}"   # SESSF: file that holds the claude pid while it runs
eval "MODEL=\${MODEL_$ROLE:-sonnet}"
SET="$(mktemp "${TMPDIR:-/tmp}/cc-settings.XXXXXX")"
BASE="$REPO/.claude/roles/$ROLE.json"; OV="$HOME/.config/job-agent/claude-overrides.json"
# the operator is closed: dontAsk refuses everything its own allow list does not name, and the overrides are never merged in
MODE=acceptEdits; [ "$ROLE" = operator ] && MODE=dontAsk
if [ "$ROLE" = operator ] && [ ! -s "$BASE" ]; then echo "cc-run: operator settings file missing" > "$OUT"; rm -f "$SET"; exit 1; fi
if [ "$ROLE" != operator ] && [ -f "$BASE" ] && [ -f "$OV" ] && command -v jq >/dev/null; then
  jq -s -f "$REPO/bin/merge-settings.jq" "$BASE" "$OV" > "$SET" && [ -s "$SET" ] || cp "$BASE" "$SET"
elif [ -f "$BASE" ]; then cp "$BASE" "$SET"; else echo '{}' > "$SET"; fi
( cd "$WD" && exec claude -p "$(cat "$PF")" --model "$MODEL" --settings "$SET" --permission-mode "$MODE" \
    --add-dir "$(dirname "$PF")" ) > "$OUT" 2>&1 </dev/null &
CPID=$!; [ -n "$SESSF" ] && echo "$CPID" > "$SESSF"
wait "$CPID"; RC=$?; [ -n "$SESSF" ] && rm -f "$SESSF"; rm -f "$SET"
if grep -aqiE "(usage|rate|session|weekly) limit|limit reached|hit your .*limit|out of (usage|credits)" "$OUT" \
   && [ -z "$(last_verdict_line "$OUT")" ]; then
  # "resets 11am" (session limit) or "resets Oct 14 at 12am" (weekly limit)
  L="$(grep -aoiE 'resets? +([a-z]{3,9} +[0-9]{1,2},? +(at +)?)?[0-9]{1,2}(:[0-9]{2})? ?[ap]m' "$OUT" | head -1)"
  T="$(printf '%s' "$L" | grep -oiE '[0-9]{1,2}(:[0-9]{2})? ?[ap]m$' | tr -d ' ' | tr 'a-z' 'A-Z')"
  case "$T" in *:*|"") ;; *) T="$(printf '%s' "$T" | sed -E 's/(AM|PM)$/:00\1/')" ;; esac
  MD="$(printf '%s' "$L" | sed -nE 's/^[Rr][Ee][Ss][Ee][Tt][Ss]? +([A-Za-z]{3})[A-Za-z]* +([0-9]{1,2}).*/\1 \2/p')"
  G="$(printf '%s' "$T" | sed -E 's/(AM|PM)$/ \1/')"
  E=""; if [ -n "$T" ] && [ -n "$MD" ]; then
    E="$(date -j -f "%b %d %I:%M%p" "$MD $T" +%s 2>/dev/null || date -d "$MD $G" +%s 2>/dev/null)"
    [ -n "$E" ] && [ "$E" -le "$(now)" ] && E=""                 # a date in the past: fall back to 1 hour
  elif [ -n "$T" ]; then
    E="$(date -j -f "%I:%M%p" "$T" +%s 2>/dev/null || date -d "$G" +%s 2>/dev/null)"
    [ -n "$E" ] && [ "$E" -le "$(now)" ] && E=$((E + 86400))   # reset time already passed today -> tomorrow
  fi
  echo "LIMIT_RESET_EPOCH=$E" >> "$OUT"; exit 42
fi
exit $RC
