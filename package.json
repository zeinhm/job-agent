{
  "repository": "https://github.com/zeinhm/job-agent",
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && bash .githooks/test-pre-commit.sh",
    "job-agent": "tsx packages/pipeline/src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "msw": "^2.4.15",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
