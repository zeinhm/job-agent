# Copy to .env (never committed). Agents only ever see this example file.
# The CLI loads <repo root>/.env itself; a variable already set in the environment wins. See docs/running.md.
# Anthropic API key for the `enrich` and `resolve-apply` LLM stages. Without it, no calls are made.
ANTHROPIC_API_KEY=
# Daily LLM spend cap in USD. Can only LOWER the built-in $1.00 cap; higher values are ignored.
JOB_AGENT_LLM_CAP_USD=
# Brave Search API key for `discover-companies` and the `linkedin_posts` source.
BRAVE_API_KEY=
# API token for the web3.career source.
WEB3_CAREER_TOKEN=
# Path overrides. Leave them commented out unless you need one: an empty value here would be used as an empty path.
# Defaults: data/job-agent.db, config, brave-usage.json next to the database.
# JOB_AGENT_DB=
# JOB_AGENT_CONFIG_DIR=
# JOB_AGENT_BRAVE_USAGE=
