# Copy to .env (never committed). Agents only ever see this example file.
# Anthropic API key for the `enrich` LLM stages. Without it, enrich makes no calls.
ANTHROPIC_API_KEY=
# Daily LLM spend cap in USD. Can only LOWER the built-in $1.00 cap; higher values are ignored.
JOB_AGENT_LLM_CAP_USD=
# Brave Search API key for `discover-companies`.
BRAVE_API_KEY=
WEB3_CAREER_TOKEN=
THREADS_ACCESS_TOKEN=
